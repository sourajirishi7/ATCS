# ============================================================================
# ATCS Backend — Environment Configuration
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored. NEVER commit real credentials.
# ============================================================================

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# SUPABASE PROJECT
# Where to find these:
#   Supabase Dashboard -> Project Settings -> API
#     Project URL      -> SUPABASE_URL
#     anon public key  -> SUPABASE_ANON_KEY
#     service_role key -> SUPABASE_SERVICE_ROLE_KEY  (backend only, NEVER frontend)
#   Supabase Dashboard -> Project Settings -> Database
#     Connection string (URI)  -> used to build DATABASE_URL / DIRECT_URL
#     DB password             -> part of both connection strings
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Private bucket that holds spending-request supporting documents.
# The bucket is created automatically on first upload if it does not exist.
SUPABASE_STORAGE_BUCKET=spending-documents

# ---------------------------------------------------------------------------
# POSTGRESQL (Supabase) — the ATCS persistent financial source of truth
#
# DATABASE_URL  : application runtime. Use the Supabase *transaction* pooler
#                 (port 6543). `pgbouncer=true` is required for Prisma.
# DIRECT_URL    : Prisma migrations / introspection. Use the *direct* connection
#                 (port 5432) because migrations need DDL and advisory locks.
#
# Replace <project-ref>, <db-password> and <region> with your project values.
# Password must be URL-encoded if it contains special characters.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# JWT Authentication (existing ATCS auth — unchanged by the Supabase migration)
# Generate a real secret, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN=1d

# ---------------------------------------------------------------------------
# Microservices
# ---------------------------------------------------------------------------
FORECAST_SERVICE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Google Gemini AI Agent (Backend only — NEVER expose to frontend)
# ---------------------------------------------------------------------------
# Obtain an API key from Google AI Studio (https://aistudio.google.com/):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
