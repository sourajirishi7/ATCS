datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. IDENTITY DOMAIN
// -------------------------------------------------------------

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // EMPLOYEE, MANAGER, FINANCE, ADMIN
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                 String            @id @default(uuid())
  name               String
  email              String            @unique
  passwordHash       String
  roleId             String
  role               Role              @relation(fields: [roleId], references: [id])
  departmentId       String?
  department         Department?       @relation(fields: [departmentId], references: [id])
  status             String            @default("ACTIVE") // ACTIVE, INACTIVE
  spendingRequests   SpendingRequest[] @relation("EmployeeRequests")
  approvals          Approval[]        @relation("ApproverApprovals")
  transactions       Transaction[]     @relation("EmployeeTransactions")
  exceptionsMade     Exception[]       @relation("RequestedExceptions")
  exceptionsReviewed Exception[]       @relation("ReviewedExceptions")
  auditLogs          AuditLog[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([departmentId])
  @@index([roleId])
}

// -------------------------------------------------------------
// 2. ORGANIZATION DOMAIN
// -------------------------------------------------------------

model Department {
  id               String            @id @default(uuid())
  name             String            @unique
  code             String            @unique
  costCenter       String
  status           String            @default("ACTIVE")
  users            User[]
  budgets          Budget[]
  spendingRequests SpendingRequest[]
  transactions     Transaction[]
  alerts           Alert[]
  forecasts        Forecast[]
  approvalRules        ApprovalRule[]
  quotationAllocations ClientQuotationAllocation[]
  createdAt            DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model CostCenter {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  departmentId String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id               String            @id @default(uuid())
  name             String            @unique
  code             String            @unique
  description      String?
  status           String            @default("ACTIVE")
  allocations      BudgetAllocation[]
  spendingRequests SpendingRequest[]
  transactions     Transaction[]
  approvalRules    ApprovalRule[]
  alerts           Alert[]
  forecasts        Forecast[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

// -------------------------------------------------------------
// 3. FINANCE DOMAIN
// -------------------------------------------------------------

model Budget {
  id           String             @id @default(uuid())
  departmentId String
  department   Department         @relation(fields: [departmentId], references: [id])
  fiscalPeriod String             // e.g. "FY2026-Q3", "FY2026-Q4"
  budgetAmount Decimal
  currency     String             @default("INR")
  status       String             @default("ACTIVE") // DRAFT, ACTIVE, CLOSED, EXPIRED, CANCELLED
  createdBy    String?
  allocations  BudgetAllocation[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([departmentId, fiscalPeriod])
  @@index([departmentId, status])
}

model BudgetAllocation {
  id              String   @id @default(uuid())
  budgetId        String
  budget          Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  allocatedAmount Decimal
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([budgetId, categoryId])
  @@index([budgetId])
  @@index([categoryId])
}

// -------------------------------------------------------------
// 4. SPENDING & COMMITMENT DOMAIN
// -------------------------------------------------------------

model SpendingRequest {
  id               String            @id @default(uuid())
  employeeId       String
  employee         User              @relation("EmployeeRequests", fields: [employeeId], references: [id])
  departmentId     String
  department       Department        @relation(fields: [departmentId], references: [id])
  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id])
  requestedAmount  Decimal
  currency         String            @default("INR")
  description      String
  vendor           String
  requestedDate    DateTime          @default(now())
  status           String            @default("SUBMITTED") // DRAFT, SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED, COMMITTED, CANCELLED
  commitment       Commitment?
  approvals        Approval[]
  exceptions       Exception[]
  decisionSnapshot DecisionSnapshot?
  alerts           Alert[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([employeeId])
  @@index([departmentId])
  @@index([categoryId])
  @@index([status])
}

model Commitment {
  id                String          @id @default(uuid())
  spendingRequestId String          @unique
  spendingRequest   SpendingRequest @relation(fields: [spendingRequestId], references: [id], onDelete: Cascade)
  committedAmount   Decimal
  remainingAmount   Decimal
  status            String          @default("ACTIVE") // ACTIVE, PARTIALLY_SETTLED, SETTLED, CANCELLED
  transactions      Transaction[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status])
}

model Transaction {
  id              String      @id @default(uuid())
  employeeId      String
  employee        User        @relation("EmployeeTransactions", fields: [employeeId], references: [id])
  departmentId    String
  department      Department  @relation(fields: [departmentId], references: [id])
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id])
  amount          Decimal
  currency        String      @default("INR")
  transactionDate DateTime    @default(now())
  vendor          String
  referenceNumber String      @unique
  source          String      @default("MANUAL") // MANUAL, CSV_IMPORT, API
  status          String      @default("RECORDED") // RECORDED, RECONCILED, REVERSED
  commitmentId    String?
  commitment      Commitment? @relation(fields: [commitmentId], references: [id])
  alerts          Alert[]
  createdAt       DateTime    @default(now())

  @@index([departmentId])
  @@index([categoryId])
  @@index([transactionDate])
  @@index([status])
}

// -------------------------------------------------------------
// 5. GOVERNANCE DOMAIN
// -------------------------------------------------------------

model Approval {
  id                String          @id @default(uuid())
  spendingRequestId String
  spendingRequest   SpendingRequest @relation(fields: [spendingRequestId], references: [id], onDelete: Cascade)
  approverId        String
  approver          User            @relation("ApproverApprovals", fields: [approverId], references: [id])
  decision          String          // APPROVED, REJECTED
  comments          String?
  decidedAt         DateTime        @default(now())

  @@index([spendingRequestId])
  @@index([approverId])
}

model BudgetRule {
  id        String   @id @default(uuid())
  ruleName  String   @unique
  ruleType  String   // e.g. "UTILIZATION_WARNING", "HARD_CEILING"
  threshold Decimal  // e.g. 80.00, 100.00
  action    String   // "WARNING", "BLOCK", "APPROVAL_REQUIRED"
  enabled   Boolean  @default(true)
  priority  Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApprovalRule {
  id            String      @id @default(uuid())
  name          String
  minimumAmount Decimal
  maximumAmount Decimal?
  requiredRole  String      @default("MANAGER")
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  categoryId    String?
  category      Category?   @relation(fields: [categoryId], references: [id])
  enabled       Boolean     @default(true)
  priority      Int         @default(100)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([departmentId])
  @@index([categoryId])
  @@index([enabled])
}

model Exception {
  id                String          @id @default(uuid())
  spendingRequestId String
  spendingRequest   SpendingRequest @relation(fields: [spendingRequestId], references: [id], onDelete: Cascade)
  type              String          // e.g. "OVER_BUDGET_OVERRIDE"
  reason            String
  requestedBy       String
  requester         User            @relation("RequestedExceptions", fields: [requestedBy], references: [id])
  reviewedBy        String?
  reviewer          User?           @relation("ReviewedExceptions", fields: [reviewedBy], references: [id])
  decision          String          @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt         DateTime        @default(now())
  reviewedAt        DateTime?

  @@index([spendingRequestId])
  @@index([decision])
}

// -------------------------------------------------------------
// 6. INTELLIGENCE DOMAIN
// -------------------------------------------------------------

model Forecast {
  id              String     @id @default(uuid())
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])
  categoryId      String?
  category        Category?  @relation(fields: [categoryId], references: [id])
  period          String
  historicalSpend Decimal
  currentBurnRate Decimal
  projectedAmount Decimal
  budgetAmount    Decimal
  variance        Decimal
  methodology     String
  confidence      Decimal
  status          String     @default("WITHIN_FORECAST") // WITHIN_FORECAST, NEAR_FORECAST_LIMIT, PROJECTED_VIOLATION, INSUFFICIENT_DATA
  createdAt       DateTime   @default(now())

  @@index([departmentId])
  @@index([status])
}

model Alert {
  id                   String           @id @default(uuid())
  type                 String
  severity             String           @default("INFO") // INFO, WARNING, CRITICAL
  departmentId         String
  department           Department       @relation(fields: [departmentId], references: [id])
  categoryId           String?
  category             Category?        @relation(fields: [categoryId], references: [id])
  relatedTransactionId String?
  transaction          Transaction?     @relation(fields: [relatedTransactionId], references: [id])
  relatedRequestId     String?
  spendingRequest      SpendingRequest? @relation(fields: [relatedRequestId], references: [id])
  message              String
  status               String           @default("ACTIVE") // ACTIVE, RESOLVED
  createdAt            DateTime         @default(now())
  resolvedAt           DateTime?

  @@index([departmentId])
  @@index([severity])
  @@index([status])
}

// -------------------------------------------------------------
// 7. AUDIT & SNAPSHOT DOMAIN
// -------------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  action        String
  entityType    String
  entityId      String
  previousValue String?
  newValue      String?
  metadata      String?
  timestamp     DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([timestamp])
}

model DecisionSnapshot {
  id                String          @id @default(uuid())
  spendingRequestId String          @unique
  spendingRequest   SpendingRequest @relation(fields: [spendingRequestId], references: [id], onDelete: Cascade)
  budgetAmount      Decimal
  actualSpend       Decimal
  committedSpend    Decimal
  requestedAmount   Decimal
  utilizationBefore Decimal
  utilizationAfter  Decimal
  remainingBefore   Decimal
  remainingAfter    Decimal
  decision          String          // APPROVE, APPROVAL_REQUIRED, WARNING, VIOLATION, INSUFFICIENT_DATA, CONFIGURATION_ERROR
  budgetStatus      String
  violations        String
  warnings          String
  reasons           String
  engineVersion     String          @default("1.0.0")
  calculatedAt      DateTime        @default(now())

  @@index([decision])
  @@index([calculatedAt])
}

// -------------------------------------------------------------
// 8. CLIENT QUOTATION & PROPOSED BUDGET DOMAIN
// -------------------------------------------------------------

model ClientQuotation {
  id                    String                      @id @default(uuid())
  clientName            String
  projectName           String
  quotationReference    String                      @unique
  proposedBudget        Decimal
  currency              String                      @default("INR")
  targetProfitMarginPct Decimal                     @default(20.0)
  status                String                      @default("ACTIVE") // DRAFT, ACTIVE, COMPLETED, ARCHIVED
  validUntil            DateTime?
  notes                 String?
  allocations           ClientQuotationAllocation[]
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
}

model ClientQuotationAllocation {
  id              String          @id @default(uuid())
  quotationId     String
  quotation       ClientQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department      @relation(fields: [departmentId], references: [id])
  allocatedAmount Decimal
  targetMarginPct Decimal         @default(20.0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([quotationId, departmentId])
  @@index([quotationId])
  @@index([departmentId])
}
