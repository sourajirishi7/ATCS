# ============================================================================
# ATCS Frontend — Environment Configuration
#
# Copy to `.env.local`:  cp .env.example .env.local
# `.env.local` is git-ignored and is the ONLY safe place for these values.
#
# SECURITY: this file may ONLY contain the public Supabase URL and the anon
# key. SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, DIRECT_URL and the database
# password must NEVER appear here — Vite inlines every VITE_* variable into the
# browser bundle.
# ============================================================================

# Supabase Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=

# Supabase Dashboard -> Project Settings -> API -> anon public key
VITE_SUPABASE_ANON_KEY=

# ATCS backend base URL. All financial reads/writes go through this API,
# never directly from the browser to Supabase tables.
VITE_API_BASE_URL=http://localhost:5000
